OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
OPENAI_MAX_TOOL_CALLS=3
OPENAI_MAX_OUTPUT_TOKENS=3000
WEB_EVIDENCE_BASE_URL=http://localhost:8000
WEB_EVIDENCE_DB=data/web-evidence.db
WEB_EVIDENCE_SNAPSHOT_DIR=data/snapshots
WEB_EVIDENCE_DATA_DIR=./data
WEB_EVIDENCE_PROVIDER_CONTACT=services@example.com
WEB_EVIDENCE_API_KEY=
ADMIN_API_KEY=
RECEIPT_SIGNING_SECRET=
WEB_EVIDENCE_PRICE_USD=0.05
WEB_EVIDENCE_QUICK_PRICE_USD=0.02
WEB_EVIDENCE_DEEP_PRICE_USD=0.12
WEB_EVIDENCE_RESEARCH_PRICE_USD=0.25
# Cost-accounting inputs. Update when the configured model/provider pricing changes.
OPENAI_INPUT_USD_PER_MILLION=0.10
OPENAI_CACHED_INPUT_USD_PER_MILLION=0.01
OPENAI_OUTPUT_USD_PER_MILLION=0.50
OPENAI_WEB_SEARCH_USD_PER_THOUSAND=10.00
PAYMENT_RECIPIENT=
MPP_SECRET_KEY=
X402_FACILITATOR_URL=https://facilitator.openx402.ai
# Optional: enables an additional MPP card/USD challenge.
STRIPE_SECRET_KEY=
STRIPE_NETWORK_ID=agentic-services
# Stripe card charges have a provider-enforced minimum; USDC keeps the tier price above.
STRIPE_MINIMUM_PRICE_USD=0.50
# Human Checkout keys belong to the separate human-sales Stripe account.
CONTRACTOR_STRIPE_SECRET_KEY=
WEB_EVIDENCE_STRIPE_SECRET_KEY=
HUMAN_STRIPE_WEBHOOK_SECRET=
# Niche Discovery: human access is USD 9.99/month; agent access is per call.
# Use a restricted key from the human-sales Stripe account with Prices read,
# Checkout Sessions write, Subscriptions read, and Billing Portal Sessions write.
NICHE_STRIPE_SECRET_KEY=
NICHE_STRIPE_PRICE_ID=
NICHE_STRIPE_WEBHOOK_SECRET=
NICHE_TOKEN_SECRET=
NICHE_PER_CALL_PRICE_USD=0.25
# Public-source collectors queue candidates for editorial review; none auto-publish.
NICHE_COLLECT_HACKER_NEWS=0
# Example: ("customer complaints" OR "users frustrated"); GDELT requires attribution.
NICHE_GDELT_QUERY=
# Explicitly reviewed repositories only; no broad social or shopping-site crawling.
NICHE_GITHUB_REPOSITORIES=
# Optional search-engine notification key. Keep the value out of version control.
INDEXNOW_KEY=

# Company-site contact form. Use a revocable Google app password, never the Gmail account password.
CONTACT_RECIPIENT_EMAIL=impanyu@gmail.com
CONTACT_SMTP_HOST=smtp.gmail.com
CONTACT_SMTP_PORT=465
CONTACT_SMTP_USERNAME=
CONTACT_SMTP_APP_PASSWORD=
CONTACT_IP_HASH_SECRET=
CONTACT_RATE_LIMIT_PER_HOUR=5

# Reddit: enable only AFTER explicit commercial approval and approved OAuth app.
NICHE_COLLECT_REDDIT=0
NICHE_REDDIT_APPROVAL_REFERENCE=
NICHE_REDDIT_CLIENT_ID=
NICHE_REDDIT_CLIENT_SECRET=
NICHE_REDDIT_REFRESH_TOKEN=
NICHE_REDDIT_USER_AGENT=
# Comma-separated approved communities, max 20; no /r/ prefixes.
NICHE_REDDIT_SUBREDDITS=

# Search discovery: server-only key; never fetches result pages or publishes leads.
NICHE_COLLECT_SEARCH=0
BRAVE_SEARCH_API_KEY=
# Reference to an actual search plan/agreement granting persistent result storage.
NICHE_SEARCH_STORAGE_REFERENCE=
# Hard request ceiling per UTC day, including failed requests; range 1..32.
NICHE_SEARCH_DAILY_REQUEST_LIMIT=8

# Autonomous Niche Manager (reuse OPENAI_API_KEY; disabled until enabled explicitly)
NICHE_AGENT_ENABLED=0
NICHE_AGENT_MODEL=gpt-6-sol
NICHE_AGENT_TICK_SECONDS=21600
NICHE_AGENT_MAX_TURNS=20
NICHE_AGENT_MAX_OUTPUT_TOKENS=4000
NICHE_AGENT_TIMEOUT_SECONDS=600
# Persisted, conservative pre-request reservations; not a dollar billing meter.
NICHE_AGENT_DAILY_REQUESTS=32
NICHE_AGENT_DAILY_RESERVED_TOKENS=300000
# Operator-managed HTTPS MCP registry. Credentials are references, never inline.
NICHE_AGENT_MCP_SERVERS=[]
# Example registry: [{"name":"research","url":"https://tools.example/mcp","bearer_env":"NICHE_MCP_RESEARCH_KEY"}]
# NICHE_MCP_RESEARCH_KEY=
# Callback subscriptions reference environment keys matching NICHE_CALLBACK_*.
# NICHE_CALLBACK_GITHUB=
# Optional permissioned document reads: exact domains, HTTPS only, redirects stay in scope.
# Direct Reddit reads are always blocked; use the authorized Reddit adapter instead.
NICHE_AGENT_FETCH_DOMAINS=
NICHE_AGENT_FETCH_REFERENCE=

# Cross-industry metadata sources. Context notices cannot satisfy demand publication gates.
NICHE_COLLECT_STACK_EXCHANGE=0
NICHE_STACK_EXCHANGE_SITES=diy,gardening,money,travel,bicycles,cooking
NICHE_COLLECT_CPSC=0
NICHE_COLLECT_FEDERAL_REGISTER=0
NICHE_COLLECT_NYC311=0
NICHE_NYC311_RIGHTS_REFERENCE=
NICHE_COLLECT_CFPB=0
# Operator-approved RSS/Atom headlines; rightsReference, license and attribution required.
# Optional hub must match the feed's advertised WebSub hub; callback secret stays server-side.
NICHE_SOURCE_FEEDS=[]
# Example: [{"id":"global-voices","url":"https://globalvoices.org/feed/","enabled":true,"hub":"https://pubsubhubbub.appspot.com/","license":"https://creativecommons.org/licenses/by/3.0/","rightsReference":"https://globalvoices.org/about/global-voices-attribution-policy/","attribution":"Global Voices","secretEnv":"NICHE_CALLBACK_INTERNAL"}]
# Human database searches: 3 free per UTC day, $9.99/month human subscription.
# Agent database searches use per-call payment. No live exploration API.
NICHE_SEARCH_PRICE_USD=0.05

# Photo Scout: reuse existing OpenAI settings; pricing disabled until configured.
PHOTO_SCOUT_ENABLED=0
# Temporarily allow free human website explorations; agent pricing is unchanged.
PHOTO_SCOUT_HUMAN_FREE_PREVIEW=0
PHOTO_SCOUT_PRICE_CENTS=0
PHOTO_SCOUT_DAILY_RUN_LIMIT=30
PHOTO_SCOUT_MAPILLARY_TOKEN=
PHOTO_SCOUT_STRIPE_SECRET_KEY=

# Open street imagery; provider-specific kill switch.
PHOTO_SCOUT_PANORAMAX_ENABLED=1

# Google Street View server credential: restrict to production IP and Street View Static API.
# Set enabled explicitly to include Google images in agent analysis.
PHOTO_SCOUT_GOOGLE_API_KEY=
PHOTO_SCOUT_GOOGLE_ENABLED=0
# Shared persistent cap; failures also count. At most 12 total images per exploration.
# 0 disables the application daily cap; request usage is still counted.
PHOTO_SCOUT_GOOGLE_DAILY_IMAGE_LIMIT=0

# Independent Photo Scout Google OAuth web application client.
PHOTO_SCOUT_GOOGLE_CLIENT_ID=
PHOTO_SCOUT_GOOGLE_CLIENT_SECRET=
PHOTO_SCOUT_OAUTH_CALLBACK=https://api.aisoup.net/photo-scout/v1/auth/callback
PHOTO_SCOUT_WEB_ORIGIN=https://aisoup.net

PHOTO_SCOUT_MODEL=gpt-6-luna
PHOTO_SCOUT_IMAGE_MODEL=gpt-image-2.5-sunburst
PHOTO_SCOUT_PORTRAIT_DAILY_LIMIT=100
