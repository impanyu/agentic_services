[Unit]
Description=Kalshi KXBTC15M trades + BRTI WebSocket recorder
After=network-online.target
Wants=network-online.target

[Service]
User=ypan12
WorkingDirectory=/home/ypan12/kalshi_rec
ExecStart=/home/ypan12/kalshi_rec/.venv/bin/python recorder.py
Restart=always
RestartSec=5
TimeoutStopSec=15
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
