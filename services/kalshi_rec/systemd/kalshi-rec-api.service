[Unit]
Description=Kalshi recorder read/write API (127.0.0.1:8765)
After=network-online.target

[Service]
User=ypan12
WorkingDirectory=/home/ypan12/kalshi_rec
ExecStart=/home/ypan12/kalshi_rec/.venv/bin/uvicorn api:app --host 127.0.0.1 --port 8765 --workers 1
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
