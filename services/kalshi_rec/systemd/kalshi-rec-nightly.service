[Unit]
Description=Kalshi recorder nightly: REST verify + back-fill, then compact to Parquet

[Service]
Type=oneshot
User=ypan12
WorkingDirectory=/home/ypan12/kalshi_rec
ExecStart=/home/ypan12/kalshi_rec/.venv/bin/python verify.py --days 3
ExecStart=/home/ypan12/kalshi_rec/.venv/bin/python compact.py
Environment=PYTHONUNBUFFERED=1
