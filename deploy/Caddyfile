wiki.aisoup.net {
	reverse_proxy 127.0.0.1:3000 {
		flush_interval -1
	}
}

adma.aisoup.net {
	reverse_proxy 127.0.0.1:3001 {
		flush_interval -1
	}
}

status.aisoup.net {
	rewrite * /status{uri}
	reverse_proxy 127.0.0.1:8010 {
		flush_interval -1
	}
}

aisoup.net, www.aisoup.net {
	handle /wiki {
		redir https://wiki.aisoup.net/ permanent
	}

	handle_path /wiki/* {
		redir https://wiki.aisoup.net{uri} permanent
	}

	handle /web-evidence {
		redir /web-evidence/ permanent
	}

	handle_path /web-evidence/* {
		root * /mnt/disks/agentic-services/app/web-evidence-site
		encode zstd gzip
		header {
			Strict-Transport-Security "max-age=31536000; includeSubDomains"
			X-Content-Type-Options "nosniff"
			Referrer-Policy "strict-origin-when-cross-origin"
			Content-Security-Policy "default-src 'self'; connect-src 'self' https://api.aisoup.net; style-src 'self'; script-src 'self'; img-src 'self' data:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
		}
		file_server
	}

	handle /contractor-check {
		redir /contractor-check/ permanent
	}

	handle_path /contractor-check/* {
		root * /mnt/disks/agentic-services/app/contractor-check-site
		encode zstd gzip
		header {
			Strict-Transport-Security "max-age=31536000; includeSubDomains"
			X-Content-Type-Options "nosniff"
			Referrer-Policy "strict-origin-when-cross-origin"
			Content-Security-Policy "default-src 'self'; connect-src 'self' https://api.aisoup.net; style-src 'self'; script-src 'self'; img-src 'self' data:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
		}
		file_server
	}

	handle /contact/messages {
		rewrite * /v1/contact/messages
		reverse_proxy 127.0.0.1:8010 {
			flush_interval -1
		}
	}

	handle {
		root * /mnt/disks/agentic-services/app/company-site/dist
		encode zstd gzip
		header {
			Strict-Transport-Security "max-age=31536000; includeSubDomains"
			X-Content-Type-Options "nosniff"
			Referrer-Policy "strict-origin-when-cross-origin"
			Content-Security-Policy "default-src 'self'; style-src 'self'; script-src 'self'; img-src 'self' data:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
		}
		file_server
	}
}

evidence.aisoup.net {
	redir https://api.aisoup.net/web-evidence{uri} permanent
}

api.aisoup.net {
	@kalshi_read {
		method GET
		path /kalshi-rec/v1/health /kalshi-rec/v1/btc15m/markets /kalshi-rec/v1/btc15m/trades /kalshi-rec/v1/brti
	}
	handle @kalshi_read {
		uri strip_prefix /kalshi-rec/v1
		reverse_proxy 127.0.0.1:8765
	}

	handle /kalshi-rec/* {
		respond 404
	}

	handle /contractor-check {
		redir https://aisoup.net/contractor-check/ permanent
	}

	handle /contractor-check/v1/* {
		reverse_proxy 127.0.0.1:8010 {
			flush_interval -1
		}
	}

	handle /contractor-check/mcp {
		reverse_proxy 127.0.0.1:8010 {
			flush_interval -1
		}
	}

	handle /contractor-check/.well-known/mcp/server.json {
		reverse_proxy 127.0.0.1:8010 {
			flush_interval -1
		}
	}

	@contractor_service_documents path /contractor-check/openapi.json /contractor-check/.well-known/agent-service.json
	handle @contractor_service_documents {
		uri strip_prefix /contractor-check
		root * /mnt/disks/agentic-services/app/contractor-check-site
		encode zstd gzip
		header {
			Strict-Transport-Security "max-age=31536000; includeSubDomains"
			X-Content-Type-Options "nosniff"
			Referrer-Policy "strict-origin-when-cross-origin"
			Content-Security-Policy "default-src 'self'; style-src 'self'; script-src 'self'; img-src 'self' data:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
		}
		file_server
	}

	handle_path /contractor-check/* {
		redir https://aisoup.net/contractor-check{uri} permanent
	}

	handle /web-evidence {
		redir https://aisoup.net/web-evidence/ permanent
	}

	handle /web-evidence/v1/* {
		reverse_proxy 127.0.0.1:8010 {
			flush_interval -1
		}
	}

	@web_evidence_service_protocol path /web-evidence/openapi.json /web-evidence/llms.txt /web-evidence/mcp /web-evidence/a2a /web-evidence/.well-known/*
	handle @web_evidence_service_protocol {
		uri strip_prefix /web-evidence
		reverse_proxy 127.0.0.1:8010 {
			flush_interval -1
		}
	}

	handle_path /web-evidence/* {
		redir https://aisoup.net/web-evidence{uri} permanent
	}

	handle {
		reverse_proxy 127.0.0.1:8010 {
			flush_interval -1
		}
	}
}
