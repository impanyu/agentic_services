  @shared_contractor-check path /v1/orders/* /v1/receipts/*
  handle @shared_contractor-check {
   import app_subdomain_proxy contractor-check
  }
  @documents_contractor_check path /.well-known/agent-service.json /openapi.json
  handle @documents_contractor_check {
   root * /mnt/disks/agentic-services/app/contractor-check-site/canonical-api
   file_server
  }
  handle {
   rewrite * /contractor-check{uri}
   import app_subdomain_proxy contractor-check
